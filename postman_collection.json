{
  "info": {
    "_postman_id": "plaidly-api-v1",
    "name": "Plaidly API",
    "description": "Official Plaidly API Postman collection. Set the `base_url` and `api_key` environment variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.plaidly.io",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "your_api_key_here",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "ses_01HZABCDEF",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Payment Sessions",
      "item": [
        {
          "name": "Create Payment Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/v1/payment_sessions", "host": ["{{base_url}}"], "path": ["v1", "payment_sessions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"expires_in\": \"15m\",\n  \"paymentMethod\": {\n    \"methodID\": 0,\n    \"chain\": \"solana\",\n    \"token\": \"USDC\",\n    \"network\": \"mainnet\"\n  },\n  \"metadata\": {\n    \"order_id\": \"ord_123\",\n    \"customer_id\": \"cust_456\"\n  }\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"session_id\": \"ses_01HZABCDEF\",\n  \"merchant_id\": \"mer_01HZX\",\n  \"expected_amount\": 100.00,\n  \"received_amount\": 0,\n  \"address\": \"9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM\",\n  \"status\": \"pending\",\n  \"currency\": \"USDC\",\n  \"payment_url\": \"https://pay.plaidly.io/ses_01HZABCDEF\",\n  \"qr_data\": \"solana:9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM?amount=100\",\n  \"explorer_url\": \"https://solscan.io/account/9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM\",\n  \"metadata\": { \"order_id\": \"ord_123\", \"customer_id\": \"cust_456\" },\n  \"expires_at\": \"2026-04-19T10:15:00Z\",\n  \"created_at\": \"2026-04-19T10:00:00Z\",\n  \"updated_at\": \"2026-04-19T10:00:00Z\",\n  \"demo\": false,\n  \"paymentMethod\": { \"methodID\": 0, \"chain\": \"solana\", \"token\": \"USDC\", \"network\": \"mainnet\" }\n}"
            }
          ]
        },
        {
          "name": "Create Demo Payment Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/v1/payment_sessions/demo", "host": ["{{base_url}}"], "path": ["v1", "payment_sessions", "demo"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chain\": \"ethereum\",\n  \"token\": \"USDC\",\n  \"network\": \"testnet\",\n  \"amount\": 25.00\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get Payment Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/payment_sessions/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "payment_sessions", "{{session_id}}"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"session_id\": \"ses_01HZABCDEF\",\n  \"merchant_id\": \"mer_01HZX\",\n  \"expected_amount\": 100.00,\n  \"received_amount\": 100.00,\n  \"address\": \"9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM\",\n  \"status\": \"completed\",\n  \"currency\": \"USDC\",\n  \"metadata\": { \"order_id\": \"ord_123\" },\n  \"expires_at\": \"2026-04-19T10:15:00Z\",\n  \"completed_at\": \"2026-04-19T10:05:00Z\",\n  \"created_at\": \"2026-04-19T10:00:00Z\",\n  \"updated_at\": \"2026-04-19T10:05:00Z\",\n  \"demo\": false,\n  \"paymentMethod\": { \"methodID\": 0, \"chain\": \"solana\", \"token\": \"USDC\", \"network\": \"mainnet\" }\n}"
            }
          ]
        },
        {
          "name": "Simulate Payment (Demo/Sandbox)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/payment_sessions/{{session_id}}/simulate",
              "host": ["{{base_url}}"],
              "path": ["v1", "payment_sessions", "{{session_id}}", "simulate"]
            }
          },
          "response": []
        }
      ]
    },
    {
