              "body": "[\n  {\n    \"chain\": \"ethereum\",\n    \"network\": \"mainnet\",\n    \"token\": \"USDC\",\n    \"display_name\": \"USD Coin (Ethereum)\",\n    \"decimals\": 6,\n    \"kind\": \"erc20\",\n    \"min_amount\": 1.0\n  }\n]"
